{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "AllowedHosts": "*",
  "MinioConfig": {
    "MinioServer": "cdn.jee.vn",
    "MinioSSL": "true"
  },
  "KafkaConfig": {
    "ProjectName": "jee-tutorial",
    "TopicProduce": {
      "JeeplatformUpdatReminder": "jeeflow.update.reminder"
    },
    "TopicConsume": {
      "AutoEventList": "auto.event.list",
      "ActionInbox": "auto.action.inbox"
    },
    "Consumer": {
      "AutoGroupEventList": "auto-event-list-group",
      "ActionGroupInbox": "auto-action-inbox-group"
    }
  },
  "AppConfig": {
    "AppCode": "JeeHR", // app code của từng app
    "DecryptKey": "JeeHR", // key giải mã của từng app
  }
}
